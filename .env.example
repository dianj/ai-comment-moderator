# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.

# Password for the moderator panel (the "AI moderation log & admin" tab).
# Leave it empty and the server generates one at start-up and prints it in the console.
ADMIN_TOKEN=

# LM Studio's OpenAI-compatible server and the model it serves.
LMSTUDIO_URL=http://localhost:1235/v1
MODERATION_MODEL=gemma-4-26b-a4b-it

# SQLite file for comments and the audit log.
MODERATION_DB=moderation.db

# Abuse limits.
MAX_COMMENT_CHARS=2000
RATE_LIMIT_PER_MINUTE=10
