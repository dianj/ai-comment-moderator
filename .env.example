# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.

# Password for the moderator panel (the "AI moderation log & admin" tab).
# Leave it empty and the server generates one at start-up and prints it in the console.
ADMIN_TOKEN=

# Any OpenAI-compatible server. LM Studio's default port is 1234; this project uses 1235.
LMSTUDIO_URL=http://localhost:1235/v1
LLM_API_KEY=lm-studio
MODERATION_MODEL=gemma-4-26b-a4b-it
# "none" skips the model's hidden reasoning: about 2 s per comment instead of up to a minute.
# Leave empty to use the model's default. evals/results/ has the measured comparison.
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_S=120

# SQLite file for comments and the audit log.
MODERATION_DB=moderation.db

# Abuse limits.
MAX_COMMENT_CHARS=2000
RATE_LIMIT_PER_MINUTE=10

# A comment the model calls "Clean" but scores at least this toxic goes to a human.
REVIEW_TOXICITY_THRESHOLD=40

# Decision gate: a calibrated second check before a comment is published or rejected automatically
# (docs/DECISIONS.md). 0 = off. CALIBRATION_DIR holds the fitted temperature per model and prompt.
DECISION_GATE=1
CALIBRATION_DIR=evals/decisions/calibration
